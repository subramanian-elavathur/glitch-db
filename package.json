{
  "name": "glitch-db",
  "version": "0.17.0",
  "description": "A simple, file based key-value database",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix",
    "*": "prettier --ignore-unknown --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subramanian-elavathur/glitch-db.git"
  },
  "keywords": [
    "glitch",
    "db",
    "database",
    "file",
    "json",
    "key-value",
    "versioning",
    "bitemporal",
    "simple",
    "local"
  ],
  "author": "Subramanian Elavathur",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/subramanian-elavathur/glitch-db/issues"
  },
  "homepage": "https://github.com/subramanian-elavathur/glitch-db#readme",
  "dependencies": {
    "lru-cache": "^11.5.3",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
